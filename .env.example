# Skopiuj do .env i uzupełnij lokalnie. .env nigdy nie trafia do gita.

# --- Baza danych ---
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_dev_password
POSTGRES_DB=leads
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://leads:leads_dev_password@db:5432/leads

# --- API ---
API_PORT=8000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Używane tylko server-side (Server Components) wewnątrz sieci Dockera — ustawiane automatycznie
# w docker-compose.yml, nie trzeba tego wpisywać ręcznie.
# API_INTERNAL_URL=http://api:8000

# --- Discovery ---
GOOGLE_PLACES_API_KEY=
# Opcjonalne: kontakt dołączany do User-Agenta zapytań do Nominatim (OpenStreetMap) zgodnie z ich
# polityką użytkowania. Zostaw puste, jeśli nie chcesz podawać żadnego kontaktu.
OSM_CONTACT_EMAIL=

# --- Wysyłka ---
# Domyślnie Mailpit: lokalna skrzynka testowa, nic nie wychodzi do internetu (podgląd: localhost:8025).
# Prawdziwa skrzynka, np. Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adres,
# SMTP_PASSWORD=hasło aplikacji.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# Nadawca -- bez tych trzech pól prawdziwa wysyłka jest zablokowana. Podpis pod każdym mailem to
# SENDER_NAME + linia SENDER_IDENTITY: czym się zajmujesz (i np. telefon). Przy działalności
# gospodarczej dopisz nazwę firmy, adres i NIP.
SENDER_NAME=
SENDER_EMAIL=
SENDER_IDENTITY=

# Limit i rozgrzewanie: przez pierwsze 4 tygodnie od MAILBOX_WARMUP_START limit rośnie 10 -> 15 -> 25 -> 35,
# potem obowiązuje DAILY_SEND_LIMIT. Puste MAILBOX_WARMUP_START = traktujemy skrzynkę jako nową (10/dzień).
DAILY_SEND_LIMIT=20
MAILBOX_WARMUP_START=
# Losowy odstęp między mailami w sekundach. Przy testach na Mailpit można dać 1-3.
SEND_DELAY_MIN_S=45
SEND_DELAY_MAX_S=120
