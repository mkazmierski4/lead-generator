# Skopiuj do .env i uzupełnij lokalnie. .env nigdy nie trafia do gita.

# --- Baza danych ---
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads_dev_password
POSTGRES_DB=leads
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://leads:leads_dev_password@db:5432/leads

# --- API ---
API_PORT=8000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Używane tylko server-side (Server Components) wewnątrz sieci Dockera — ustawiane automatycznie
# w docker-compose.yml, nie trzeba tego wpisywać ręcznie.
# API_INTERNAL_URL=http://api:8000

# --- Discovery ---
GOOGLE_PLACES_API_KEY=
# Opcjonalne: kontakt dołączany do User-Agenta zapytań do Nominatim (OpenStreetMap) zgodnie z ich
# polityką użytkowania. Zostaw puste, jeśli nie chcesz podawać żadnego kontaktu.
OSM_CONTACT_EMAIL=

# --- Mailer (do uzupełnienia w etapie Mailer Engine) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DAILY_SEND_LIMIT=20
